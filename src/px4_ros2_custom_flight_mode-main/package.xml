<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>draw_flight_mode</name>
  <version>0.1.0</version>
  <description>
    Three-drone PX4 ROS 2 swarm that draws the letter R at 50 m AGL.
    Uses CBF-QP collision avoidance and a three-way synchronisation barrier.
    Custom mode names visible in QGroundControl:
      draw_straight_line (Drone 1), draw_diagonal (Drone 2), draw_curve (Drone 3).
  </description>
  <maintainer email="user@todo.todo">user</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>eigen3_cmake_module</buildtool_depend>
  <buildtool_export_depend>eigen3_cmake_module</buildtool_export_depend>

  <build_depend>eigen</build_depend>
  <build_export_depend>eigen</build_export_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>px4_ros2_cpp</depend>
  <depend>px4_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
